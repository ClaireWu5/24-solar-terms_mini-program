.share-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 70;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 60rpx;
  background: rgba(30, 25, 18, 0.55);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.share-mask.show { opacity: 1; pointer-events: auto; }

.share-card {
  width: 540rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #F6F3EC;
  box-shadow: 0 60rpx 120rpx -40rpx rgba(0, 0, 0, 0.5);
  transform: scale(0.9);
  transition: transform 0.34s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.share-mask.show .share-card { transform: scale(1); }

.sc-art { height: 460rpx; position: relative; background: #EFE7D5; }
.sc-img { width: 100%; height: 100%; display: block; }
.sc-canvas { width: 100%; height: 100%; display: block; }

.sc-body { padding: 36rpx 40rpx 32rpx; text-align: center; }
.sc-term { font-size: 60rpx; letter-spacing: 16rpx; text-indent: 16rpx; color: #2B2A26; }
.sc-pentad { font-size: 24rpx; color: #C47A3A; letter-spacing: 6rpx; margin-top: 12rpx; }
.sc-verse {
  font-size: 28rpx;
  line-height: 1.9;
  color: #5C574C;
  margin-top: 28rpx;
  letter-spacing: 2rpx;
}
.sc-div { width: 60rpx; height: 2rpx; background: rgba(80, 75, 60, 0.2); margin: 32rpx auto; }
.sc-heritage { font-size: 19rpx; line-height: 1.6; color: #A39C8B; letter-spacing: 1rpx; }

.sc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  border-top: 1rpx solid rgba(80, 75, 60, 0.12);
}
.sc-foot .brand { font-size: 26rpx; letter-spacing: 4rpx; color: #2B2A26; }
.sc-qr {
  width: 76rpx; height: 76rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(80, 75, 60, 0.2);
  background:
    repeating-linear-gradient(0deg, #2B2A26 0 4rpx, transparent 4rpx 8rpx),
    repeating-linear-gradient(90deg, #2B2A26 0 4rpx, transparent 4rpx 8rpx);
  background-size: 16rpx 16rpx;
  opacity: 0.55;
}

.share-ops { display: flex; gap: 56rpx; margin-top: 44rpx; }
.share-op { display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #fff; }
.share-op .c {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.share-op .t { font-size: 22rpx; letter-spacing: 2rpx; }

.share-btn {
  background: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  border: none;
}
.share-btn::after { border: none; }

.share-close {
  margin-top: 44rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}
