/* 今日首页 · 视觉规格迁移自 preview_miniapp.html（px→rpx ×2） */

.home {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 28rpx 52rpx 40rpx;
}

.season {
  font-size: 24rpx;
  letter-spacing: 12rpx;
  color: var(--ink-faint);
}

.term {
  font-size: 120rpx;
  letter-spacing: 28rpx;
  text-indent: 28rpx;
  font-weight: 500;
  margin-top: 32rpx;
  color: var(--ink);
}

.huang {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: var(--ink-faint);
  margin-top: 24rpx;
}

.pentad {
  margin-top: 28rpx;
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.45);
  border: 1rpx solid var(--line);
}
.pentad:active { transform: scale(0.96); background: rgba(255, 255, 255, 0.7); }
.p-ord {
  font-size: 22rpx;
  color: #fff;
  background: var(--accent);
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
  letter-spacing: 2rpx;
}
.p-name { font-size: 34rpx; letter-spacing: 6rpx; color: var(--ink); }
.p-tip { font-size: 20rpx; color: var(--ink-faint); letter-spacing: 2rpx; }

/* ---- AI 意境图 ---- */
.art {
  margin-top: 52rpx;
  width: 460rpx;
  height: 576rpx;
  border-radius: 32rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(170deg, var(--art-a) 0%, var(--art-b) 100%);
  box-shadow: 0 44rpx 88rpx -44rpx rgba(70, 60, 40, 0.4);
}
.art-img { width: 100%; height: 100%; display: block; }

/* 无图兜底：材质底色 + 山峦层次 + 节气名（PRD AC3） */
.art-fallback { position: absolute; inset: 0; }
.art-sun {
  position: absolute;
  right: 60rpx; top: 90rpx;
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(201, 162, 75, 0.8);
  background: rgba(232, 200, 120, 0.12);
}
.art-mount { position: absolute; left: 0; right: 0; border-radius: 50% 50% 0 0 / 60rpx 60rpx 0 0; }
.art-mount.m1 { bottom: 150rpx; height: 220rpx; background: #C9CBBA; opacity: 0.5; }
.art-mount.m2 { bottom: 90rpx; height: 200rpx; background: #9CA593; opacity: 0.55; }
.art-mount.m3 { bottom: 0; height: 130rpx; background: var(--jade); opacity: 0.5; border-radius: 0; }
.art-term {
  position: absolute;
  left: 0; right: 0; bottom: 56rpx;
  font-size: 44rpx;
  letter-spacing: 16rpx;
  color: rgba(44, 36, 32, 0.55);
}
.ai-badge {
  position: absolute;
  left: 20rpx; top: 20rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--ink-fade);
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  padding: 4rpx 14rpx;
}

/* ---- 今日絮语 ---- */
.verse { margin-top: 48rpx; max-width: 540rpx; }
.verse .bar { width: 56rpx; height: 2rpx; background: var(--accent-d); margin: 0 auto 28rpx; }
.verse .txt {
  font-size: 34rpx;
  line-height: 2;
  letter-spacing: 4rpx;
  color: var(--ink-soft);
}
.verse .label { font-size: 20rpx; letter-spacing: 8rpx; color: var(--ink-faint); margin-top: 24rpx; }

/* ---- 倒计时 ---- */
.cd-wrap { margin-top: 52rpx; }
.cd-label { font-size: 22rpx; letter-spacing: 6rpx; color: var(--ink-fade); }
.cd { margin-top: 20rpx; display: flex; align-items: baseline; justify-content: center; gap: 6rpx; color: var(--ink); }
.cd .n { font-size: 52rpx; font-weight: 600; min-width: 40rpx; text-align: center; }
.cd .u { font-size: 22rpx; color: var(--ink-fade); margin-right: 12rpx; }

/* ---- 双按钮 ---- */
.actions { margin-top: 60rpx; display: flex; gap: 24rpx; width: 100%; }
.actions button { flex: 1; padding: 28rpx 0; }

.foot-note { font-size: 20rpx; color: var(--ink-faint); letter-spacing: 2rpx; margin-top: 52rpx; }

/* ---- 骨架屏（PRD 4.9） ---- */
.skeleton {
  position: relative;
  z-index: 10;
  padding: 120rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sk-line {
  width: 320rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #E8E0D5;
  margin-bottom: 40rpx;
  animation: shimmer 1.4s ease-in-out infinite;
}
.sk-title { width: 480rpx; height: 120rpx; border-radius: 24rpx; }
.sk-art { width: 460rpx; height: 576rpx; border-radius: 32rpx; margin-bottom: 40rpx; animation: shimmer 1.4s ease-in-out infinite; }
.sk-short { width: 220rpx; }

@keyframes shimmer {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
